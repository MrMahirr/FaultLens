DB_HOST=localhost
DB_PORT=5433
DB_NAME=faultlens
DB_USER=faultlens
DB_PASS=faultlens
KAFKA_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
# >= 32 bytes, generate with: openssl rand -base64 48
# Empty -> random key per start (all sessions end on restart). The old example value is rejected.
JWT_SECRET=
AI_ENABLED=false
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3000
# Comma-separated directories that LOCAL_FILE sources may read (e.g. /var/log,/opt/app/logs)
COLLECTOR_FILE_ALLOWED_DIRS=/var/log
# Initial 'admin' password (min 8 chars). Leave empty to generate one (printed once in the backend log).
# Must be changed at first login.
ADMIN_INITIAL_PASSWORD=
