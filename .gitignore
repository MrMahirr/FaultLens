# ====================================================================
# Global Git Ignore for FaultLens (Root)
# ====================================================================

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.project
.classpath
.settings/
.factorypath
*.sublime-project
*.sublime-workspace

# Obsidian vault (local project notes / todo list)
FaultLens-Vault/

# Ruflo / Claude Flow runtime state (local memory DB, daemon pid, metrics)
.claude-flow/
.swarm/

# Secrets / credentials (never commit)
*.pem
*.key
*.p12
*.jks
id_rsa*
kubeconfig*

# Temporary & Log files
*.log
*.tmp
*.temp

# Local environment configuration files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ====================================================================
# Backend (faultlens-backend)
# ====================================================================
faultlens-backend/target/
faultlens-backend/*/target/
faultlens-backend/.env
faultlens-backend/*.log
faultlens-backend/logs/

# Maven Wrapper downloads the distribution itself (see .mvn/wrapper/maven-wrapper.properties)
faultlens-backend/.mvn/apache-maven-*/
faultlens-backend/.mvn/*.zip

# ====================================================================
# Frontend (faultlens-frontend)
# ====================================================================
faultlens-frontend/node_modules/
faultlens-frontend/.next/
faultlens-frontend/out/
faultlens-frontend/build/
faultlens-frontend/coverage/
faultlens-frontend/*.tsbuildinfo

# graphify knowledge-graph output (generated, ~20 MB; rebuild with the graphify skill)
graphify-out/
