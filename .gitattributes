# Scripts run by sh/bash must keep LF line endings even on Windows checkouts
# (core.autocrlf=true); with CRLF, sh reads a trailing carriage return on every
# line and e.g. the git hook's `cd faultlens-frontend` fails.
*.sh text eol=lf
mvnw text eol=lf
faultlens-frontend/.husky/* text eol=lf

# Generated API contract and the TypeScript generated from it (P10 / 1.3): always LF, so the
# files regenerated on Windows and on Linux are byte-identical and CI's `git diff --exit-code`
# never trips over line endings.
contracts/*.json text eol=lf
faultlens-frontend/shared/api/schema.d.ts text eol=lf
