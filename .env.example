# ====================================================================
# docker compose variables (docker-compose.yml / docker-compose.prod.yml)
# Copy to `.env` in the repository root; `.env` is git-ignored.
# Running the backend without Docker? See faultlens-backend/.env.example.
# ====================================================================

# --- Security -------------------------------------------------------
# JWT signing key, >= 32 bytes. Generate: openssl rand -base64 48
# Empty -> random key per backend start (all sessions end on restart).
JWT_SECRET=

# Initial password of the 'admin' account (>= 8 chars). Only used when no admin
# exists yet, or the admin still has a well-known default password.
# Empty -> generated and printed once in the backend log. Must be changed at first login.
ADMIN_INITIAL_PASSWORD=

# Origins allowed for the REST API and the /ws/logs WebSocket (comma-separated).
CORS_ORIGINS=http://localhost:3000

# --- Collector ------------------------------------------------------
# Directories (inside the backend container) LOCAL_FILE sources may read, comma-separated.
COLLECTOR_FILE_ALLOWED_DIRS=/var/log

# --- AI analysis ----------------------------------------------------
AI_ENABLED=false
OPENAI_API_KEY=

# --- Frontend (baked into the image at BUILD time) ------------------
# URLs used by the browser. Rebuild the frontend image after changing them:
#   docker compose build frontend && docker compose up -d frontend
NEXT_PUBLIC_API_URL=http://localhost:3500/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3500/ws

# --- Production compose only (docker-compose.prod.yml) --------------
# DB_HOST=
# DB_PORT=5432
# DB_NAME=faultlens
# DB_USER=
# DB_PASS=
# REDIS_HOST=
# REDIS_PORT=6379
# KAFKA_SERVERS=
# BACKEND_PORT=3500
# FRONTEND_PORT=3000
